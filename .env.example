# Copy this file to .env and fill in your own values. .env is never committed.
#
# Adzuna searches job listings across many companies.
# Free key: https://developer.adzuna.com/
# Optional — without it, Job Gremlin only searches the companies in me/companies.txt.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Two-letter country code for Adzuna searches (us, gb, ca, au, de, ...)
ADZUNA_COUNTRY=us
